{
  "name": "campus-canteen-server",
  "version": "0.1.0",
  "description": "Campus Canteen API (Fastify + Prisma + MySQL)",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/jwt": "^9.1.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^8.3.0",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.44.7",
    "fastify": "^5.12.7",
    "fastify-plugin": "^5.1.0",
    "firebase-admin": "^13.10.0",
    "mysql2": "^3.24.6",
    "node-cron": "^3.0.3",
    "socket.io": "^4.8.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/node-cron": "^3.0.11",
    "drizzle-kit": "^0.31.11",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
