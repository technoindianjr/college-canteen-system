# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1

# MySQL (local on the Mac mini)
DATABASE_URL="mysql://canteen:CHANGE_ME@127.0.0.1:3306/canteen"

# Long random string: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Firebase service account (Phone Auth + push). Path to the JSON key file.
# Leave empty to disable push; login then only works in AUTH_DEV_MODE.
FIREBASE_SERVICE_ACCOUNT_PATH=

# DEV ONLY: accept "dev:+919876543210" as an idToken so you can log in without SMS.
# Refused when NODE_ENV=production.
AUTH_DEV_MODE=true

# Phone numbers (E.164) that become admin on first login, comma separated
ADMIN_PHONES=+919999999999

# First web-console admin, created by `npm run db:seed` (email + password login). Remove the password afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Where uploaded menu photos are stored (served at /uploads)
UPLOAD_DIR=./uploads

# Comma-separated origins allowed to call the API from a browser (admin web, staff web)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
